rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'phone', 'timestamp'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30
        && data.timestamp is string && data.timestamp.size() <= 100;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Site content (About Us video, Org info, Founder info, Programs, etc.)
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Patient & Family Emergency / Admission Inquiries
    match /inquiries/{inquiryId} {
      allow read: if true;
      allow create: if isValidInquiry(request.resource.data);
      allow update, delete: if true;
    }
  }
}
